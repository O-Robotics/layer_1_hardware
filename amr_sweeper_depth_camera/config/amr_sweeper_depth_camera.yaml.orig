/**:
  ros__parameters:
    serial_no:                        ""             # Leave empty to auto-select the detected D555.
    wait_for_device_timeout:          15.0           # Fail fast enough for bringup diagnostics, but still allow normal USB enumeration time.
    reconnect_timeout:                2.0            # Retry dropped-camera reconnects quickly to shorten stream outages.
    diagnostics_period:               1.0            # Publish RealSense diagnostics so stream-rate issues are visible on /diagnostics.
    initial_reset:                    false          # Keep default startup fast; enable only if this specific camera needs a hardware reset to come up cleanly.

    # -- Color stream ----------------------------------------------------------
    enable_color:                     true
    rgb_camera.color_profile:         448x252x5     # Lower RGB resolution to keep USB and CPU load down during navigation.
    rgb_camera.color_format:          RGB8
    rgb_camera.global_time_enabled:   false          # Disable D555 DDS global-time polling; it has been a repeated source of low-level timeout errors during startup.

    # -- Stereo depth + IR streams --------------------------------------------
    enable_depth:                     true
    depth_module.depth_profile:       448x252x15    # Reduce depth resolution and frame rate to avoid stream-profile conflicts and lower device load.
    depth_module.depth_format:        Z16
    depth_module.global_time_enabled: false

    enable_infra1:                    true
    enable_infra2:                    true
    depth_module.infra_profile:       448x252x15    # Must match the active depth_module profile when infrared streams are enabled.
    depth_module.infra1_format:       Y8
    depth_module.infra2_format:       Y8

    # -- Motion stream ---------------------------------------------------------
    enable_motion:                    false           # D555 DDS devices expose combined IMU samples on ~/motion/sample.
    enable_accel:                     false
    enable_gyro:                      false
    motion_fps:                       100
    motion_module.global_time_enabled: false

    # -- Derived outputs -------------------------------------------------------
    enable_sync:                      false
    pointcloud.enable:                false
    pointcloud.stream_filter:         2
    pointcloud.stream_index_filter:   0
    align_depth.enable:               false

    # -- TF / buffering --------------------------------------------------------
    hold_back_imu_for_frames:         false
    publish_tf:                       false
    tf_publish_rate:                  0.0
