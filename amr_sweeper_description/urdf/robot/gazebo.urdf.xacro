<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr_sweeper">

  <xacro:arg name="robot_namespace" default="amr_sweeper"/>
  <xacro:arg name="entity_name" default="amr_sweeper"/>
  <xacro:arg name="use_simulation" default="true"/>
  <xacro:arg name="simulation_physics" default="true"/>
  <xacro:arg name="use_ros2_control" default="false"/>
  <xacro:arg name="enable_usb_cameras" default="false"/>
  <xacro:arg name="enable_gnss" default="true"/>
  <xacro:arg name="enable_imu" default="true"/>
  <xacro:arg name="enable_depth_camera" default="true"/>

  <xacro:include filename="$(find amr_sweeper_description)/urdf/robot/robot.urdf.xacro"/>

  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <topic>/gazebo/imu/data_raw</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.003</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.003</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.003</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="base_link_to_chassis_link">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="imu_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="depth_camera_link">
    <sensor name="depth_camera_sensor" type="depth_camera">
      <always_on>true</always_on>
      <update_rate>15.0</update_rate>
      <visualize>false</visualize>
      <topic>/gazebo/depth_camera/image_rect_raw</topic>
      <camera>
        <horizontal_fov>1.51843644924</horizontal_fov>
        <image>
          <width>448</width>
          <height>252</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.20</near>
          <far>5.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="depth_camera_infra1_frame">
    <sensor name="depth_camera_infra1_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>15.0</update_rate>
      <visualize>false</visualize>
      <topic>/gazebo/depth_camera/infra1/image_rect_raw</topic>
      <camera>
        <horizontal_fov>1.51843644924</horizontal_fov>
        <image>
          <width>448</width>
          <height>252</height>
          <format>L_INT8</format>
        </image>
        <clip>
          <near>0.20</near>
          <far>20.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="depth_camera_infra2_frame">
    <sensor name="depth_camera_infra2_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>15.0</update_rate>
      <visualize>false</visualize>
      <topic>/gazebo/depth_camera/infra2/image_rect_raw</topic>
      <camera>
        <horizontal_fov>1.51843644924</horizontal_fov>
        <image>
          <width>448</width>
          <height>252</height>
          <format>L_INT8</format>
        </image>
        <clip>
          <near>0.20</near>
          <far>20.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>LeftWheel_joint</left_joint>
      <right_joint>RightWheel_joint</right_joint>
      <wheel_separation>0.49</wheel_separation>
      <wheel_radius>0.13</wheel_radius>
      <odom_publish_frequency>50.0</odom_publish_frequency>
      <topic>/gazebo/sweeping_controller/cmd_vel_drive</topic>
      <odom_topic>/gazebo/drive_controller/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>50.0</update_frequency>
      <topic>/model/$(arg entity_name)/pose</topic>
    </plugin>
  </gazebo>

</robot>
